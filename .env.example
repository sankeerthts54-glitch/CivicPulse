# ============================================
# CivicPulse AI — Environment Variables
# Copy this to .env and fill in your values
# ============================================

# Google AI / Gemini
GEMINI_API_KEY=your_gemini_api_key_from_aistudio

# Firebase / GCP
FIREBASE_PROJECT_ID=civicpulse-ai
GOOGLE_CLOUD_PROJECT=civicpulse-ai

# Google Maps (for dashboard heatmap)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_maps_api_key

# Cloud Translation API (uses ADC in prod, key for local dev)
GOOGLE_TRANSLATE_API_KEY=your_translate_api_key

# App config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=civicpulse-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=civicpulse-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=civicpulse-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
